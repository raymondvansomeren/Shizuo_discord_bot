# Required: the bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register slash commands only in this server (instant updates while developing).
# Leave empty to register them globally.
DEV_GUILD_ID=

# Register slash commands automatically on startup (true/false)
AUTO_DEPLOY_COMMANDS=true

# trace | debug | info | warn | error
LOG_LEVEL=info

EMBED_COLOR=#5E202E
SUPPORT_URL=https://discord.gg/ZQ23K2AkJz
# Leave empty to generate an invite link with the right permissions automatically
INVITE_URL=

# Music
# Leave the voice channel after this many seconds without music
IDLE_TIMEOUT_SECONDS=120
# Leave the voice channel after this many seconds when nobody else is listening
ALONE_TIMEOUT_SECONDS=60
MAX_PLAYLIST_SIZE=500
MAX_QUEUE_SIZE=1000

# yt-dlp (handles all YouTube / YouTube Music extraction)
# Path to a custom yt-dlp binary; leave empty to use the one bundled through npm
YTDLP_PATH=
# Netscape-format cookies.txt, only needed when YouTube asks to "confirm you're not a bot"
YTDLP_COOKIES=
# Let yt-dlp update itself on startup and every 24 hours (YouTube changes often)
YTDLP_AUTO_UPDATE=true

# Bot list sites (only posted when not using DEV_GUILD_ID)
TOPGG_TOKEN=
DISCORDBOTSGG_TOKEN=
DISCORDBOTLIST_TOKEN=
